# Server port (matches the code default in index.js so the client's
# NEXT_PUBLIC_SERVER_URL example lines up out of the box)
PORT=3001

# CORS origin - comma-separated EXACT frontend URL(s). Required in production.
#   e.g. CLIENT_URL=https://bluff-game-staging.vercel.app
CLIENT_URL=http://localhost:3000

# Optional: additionally allow any origin matching this regex. Used on the
# staging host (Railway) so DYNAMIC Vercel preview URLs work without redeploying
# the server. Anchor it to your project + Vercel scope so random *.vercel.app
# projects can't match. Leave unset on production (Render) to stay exact-match.
#   PREVIEW_ORIGIN_REGEX=^https://bluff-game-[a-z0-9-]+-honour-boys-projects\.vercel\.app$

# Supabase project settings (server-side - use service role key, never expose to browser)
SUPABASE_URL=https://rvtfzjkxgplvxanlcngh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
